{
  // EastScape's game server: one Durable Object ("the world") that runs every
  // scene, decides every hit, drop and level, and keeps every character.
  // Deploy: cd eastscape-worker && npx wrangler deploy
  // Local:  cd eastscape-worker && npx wrangler dev --var DEV:1   (lets localhost connect as a dev admin)
  "$schema": "../worker/node_modules/wrangler/config-schema.json",
  "name": "eastcoin-eastscape",
  "main": "src/index.js",
  "compatibility_date": "2026-08-21",
  "workers_dev": true,
  // its own name on our domain: some school/work networks and ad-blockers block *.workers.dev
  "routes": [{ "pattern": "play.eastcoin.vip", "custom_domain": true }],
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "WORLD", "class_name": "World" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }],
  // (2026-10-01) the internal game plan's pages (tools/gameplan-build.mjs makes the folder). run_worker_first: every request still reaches the
  // worker, which hands /gameplan/* to ASSETS only behind PLAN_KEY; nothing in the folder is ever served on its own.
  "assets": { "directory": "./gameplan-site", "binding": "ASSETS", "run_worker_first": true },
  // (2026-09-30) Cloudflare keeps the server's logs, so a crash's error is still there to read afterwards (the game only logs errors)
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ALLOWED_ORIGINS": "https://eastcoin.vip,https://www.eastcoin.vip,https://eastcoins.pages.dev,http://localhost:4321,http://127.0.0.1:4321",
    // where tickets are checked: the site's /api/eastscape/verify
    "SITE": "https://eastcoin.vip",
    // "1" only under `wrangler dev`: lets a localhost page connect as a dev admin without a ticket
    "DEV": "0"
  }
}
