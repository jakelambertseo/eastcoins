diff --git a/assets/eastcoins-multiview-servers.js b/assets/eastcoins-multiview-servers.js
new file mode 100644
--- /dev/null
+++ b/assets/eastcoins-multiview-servers.js
@@ -0,0 +1,640 @@
+(() => {
+  "use strict";
+
+  const API =
+    window.EastcoinStreamedAPI;
+
+  const MV =
+    window.EastcoinMultiviewBridge;
+
+  if (!API || !MV) {
+    console.warn(
+      "EastCoin MultiView server selector could not initialize."
+    );
+    return;
+  }
+
+  const panels = [
+    ...document.querySelectorAll(
+      ".mv-panel[data-slot]"
+    )
+  ];
+
+  const toast =
+    document.getElementById(
+      "mvToast"
+    );
+
+  const SELECTIONS_KEY =
+    "eastcoinMultiviewServerSelectionsV1";
+
+  let catalogPromise = null;
+  let toastTimer = 0;
+
+  function showToast(message) {
+    if (!toast) return;
+
+    toast.textContent =
+      String(message || "");
+
+    toast.classList.add(
+      "show"
+    );
+
+    window.clearTimeout(
+      toastTimer
+    );
+
+    toastTimer =
+      window.setTimeout(
+        () =>
+          toast.classList.remove(
+            "show"
+          ),
+        2400
+      );
+  }
+
+  function readSelections() {
+    try {
+      const parsed = JSON.parse(
+        localStorage.getItem(
+          SELECTIONS_KEY
+        ) || "{}"
+      );
+
+      return (
+        parsed &&
+        typeof parsed === "object"
+      )
+        ? parsed
+        : {};
+    } catch {
+      return {};
+    }
+  }
+
+  function selectionKey(
+    slot,
+    eventId
+  ) {
+    return `${slot}:${eventId}`;
+  }
+
+  function saveSelection(
+    slot,
+    eventId,
+    stream,
+    index
+  ) {
+    try {
+      const selections =
+        readSelections();
+
+      selections[
+        selectionKey(
+          slot,
+          eventId
+        )
+      ] = {
+        url:
+          String(
+            stream?.embedUrl ||
+            ""
+          ),
+        index,
+        savedAt:
+          Date.now()
+      };
+
+      localStorage.setItem(
+        SELECTIONS_KEY,
+        JSON.stringify(
+          selections
+        )
+      );
+    } catch {}
+  }
+
+  function savedSelection(
+    slot,
+    eventId
+  ) {
+    return readSelections()[
+      selectionKey(
+        slot,
+        eventId
+      )
+    ] || null;
+  }
+
+  function eventKey(match) {
+    return String(
+      match?.id ||
+      match?.matchId ||
+      match?.slug ||
+      `${match?.category || "event"}:${match?.title || ""}:${match?.date || ""}`
+    );
+  }
+
+  function sourceEventId(
+    source
+  ) {
+    if (!source) return "";
+
+    if (
+      source.type ===
+      "event"
+    ) {
+      return String(
+        source.id ||
+        ""
+      );
+    }
+
+    return String(
+      source.eventId ||
+      ""
+    );
+  }
+
+  function cleanCollection(
+    result
+  ) {
+    if (Array.isArray(result)) {
+      return result;
+    }
+
+    if (
+      Array.isArray(
+        result?.data
+      )
+    ) {
+      return result.data;
+    }
+
+    return [];
+  }
+
+  async function allEvents() {
+    if (catalogPromise) {
+      return catalogPromise;
+    }
+
+    catalogPromise =
+      (async () => {
+        const result =
+          await API.getAll(
+            false
+          );
+
+        return cleanCollection(
+          result
+        );
+      })()
+        .catch((error) => {
+          catalogPromise = null;
+          throw error;
+        });
+
+    return catalogPromise;
+  }
+
+  async function resolveEvent(
+    eventId
+  ) {
+    const events =
+      await allEvents();
+
+    return (
+      events.find(
+        (match) =>
+          eventKey(match) ===
+          String(eventId)
+      ) || null
+    );
+  }
+
+  function ensureServerMenu(
+    panel
+  ) {
+    let menu =
+      panel.querySelector(
+        ".mv-server-menu"
+      );
+
+    if (menu) return menu;
+
+    menu =
+      document.createElement(
+        "div"
+      );
+
+    menu.className =
+      "mv-server-menu";
+
+    menu.hidden = true;
+
+    panel.appendChild(
+      menu
+    );
+
+    return menu;
+  }
+
+  function closeMenus(
+    except = null
+  ) {
+    panels.forEach(
+      (panel) => {
+        const menu =
+          panel.querySelector(
+            ".mv-server-menu"
+          );
+
+        if (
+          menu &&
+          menu !== except
+        ) {
+          menu.hidden = true;
+        }
+      }
+    );
+  }
+
+  function syncButton(
+    panel,
+    slot
+  ) {
+    const button =
+      panel.querySelector(
+        "[data-panel-server]"
+      );
+
+    if (!button) return;
+
+    const source =
+      MV.getSource(slot);
+
+    const eventId =
+      sourceEventId(source);
+
+    button.hidden =
+      !eventId;
+
+    if (!eventId) {
+      button.textContent =
+        "Servers ▾";
+
+      ensureServerMenu(
+        panel
+      ).hidden = true;
+
+      return;
+    }
+
+    const saved =
+      savedSelection(
+        slot,
+        eventId
+      );
+
+    const selected =
+      saved &&
+      source?.url &&
+      saved.url ===
+        source.url;
+
+    button.textContent =
+      selected &&
+      Number.isInteger(
+        Number(
+          saved.index
+        )
+      )
+        ? `Server ${Number(saved.index) + 1} ▾`
+        : "Servers ▾";
+  }
+
+  async function openServers(
+    panel,
+    slot
+  ) {
+    const source =
+      MV.getSource(slot);
+
+    const eventId =
+      sourceEventId(source);
+
+    if (!eventId) {
+      showToast(
+        "Server switching is available for EastCoin events."
+      );
+      return;
+    }
+
+    const menu =
+      ensureServerMenu(
+        panel
+      );
+
+    const wasOpen =
+      !menu.hidden;
+
+    closeMenus();
+
+    if (wasOpen) {
+      menu.hidden = true;
+      return;
+    }
+
+    menu.hidden = false;
+    menu.innerHTML = `
+      <div class="mv-server-menu-head">
+        <strong>Servers</strong>
+        <small>Loading…</small>
+      </div>
+    `;
+
+    try {
+      const match =
+        await resolveEvent(
+          eventId
+        );
+
+      if (!match) {
+        throw new Error(
+          "This event is no longer in the EastCoin event catalog."
+        );
+      }
+
+      const streams =
+        (
+          await API.getStreams(
+            match,
+            false
+          )
+        ).filter(
+          (stream) =>
+            Boolean(
+              stream?.embedUrl
+            )
+        );
+
+      if (!streams.length) {
+        throw new Error(
+          "No playable servers are available for this event."
+        );
+      }
+
+      const saved =
+        savedSelection(
+          slot,
+          eventId
+        );
+
+      const activeUrl =
+        source?.type ===
+        "url"
+          ? String(
+              source.url ||
+              ""
+            )
+          : String(
+              saved?.url ||
+              ""
+            );
+
+      menu.innerHTML = `
+        <div class="mv-server-menu-head">
+          <strong>Choose server</strong>
+          <small>${streams.length} available</small>
+        </div>
+        <div class="mv-server-options"></div>
+      `;
+
+      const options =
+        menu.querySelector(
+          ".mv-server-options"
+        );
+
+      streams.forEach(
+        (
+          stream,
+          index
+        ) => {
+          const button =
+            document.createElement(
+              "button"
+            );
+
+          button.type =
+            "button";
+
+          button.className =
+            "mv-server-option";
+
+          button.classList.toggle(
+            "active",
+            activeUrl ===
+              String(
+                stream.embedUrl
+              ) ||
+            (
+              !activeUrl &&
+              index === 0
+            )
+          );
+
+          button.innerHTML = `
+            <span>Server ${index + 1}</span>
+            <small>${button.classList.contains("active") ? "Current" : "Switch"}</small>
+          `;
+
+          button.addEventListener(
+            "click",
+            () => {
+              saveSelection(
+                slot,
+                eventId,
+                stream,
+                index
+              );
+
+              /*
+                Reuse MultiView's existing URL-source path for the selected
+                provider iframe. eventId stays attached so the Servers button
+                remains available after the panel changes or the page reloads.
+              */
+              MV.setSource(
+                slot,
+                {
+                  type: "url",
+                  url:
+                    String(
+                      stream.embedUrl
+                    ),
+                  eventId,
+                  title:
+                    String(
+                      source?.title ||
+                      match?.title ||
+                      `Stream ${slot + 1}`
+                    ),
+                  meta:
+                    String(
+                      source?.meta ||
+                      "EastCoin event"
+                    )
+                }
+              );
+
+              menu.hidden =
+                true;
+
+              syncButton(
+                panel,
+                slot
+              );
+
+              showToast(
+                `Panel ${slot + 1} switched to Server ${index + 1}.`
+              );
+            }
+          );
+
+          options.appendChild(
+            button
+          );
+        }
+      );
+    } catch (error) {
+      menu.innerHTML = `
+        <div class="mv-server-menu-head">
+          <strong>Servers unavailable</strong>
+          <small>${String(error?.message || "Try again.")}</small>
+        </div>
+      `;
+    }
+  }
+
+  panels.forEach(
+    (
+      panel,
+      slot
+    ) => {
+      const actions =
+        panel.querySelector(
+          ".mv-panel-actions"
+        );
+
+      if (!actions) return;
+
+      let button =
+        actions.querySelector(
+          "[data-panel-server]"
+        );
+
+      if (!button) {
+        button =
+          document.createElement(
+            "button"
+          );
+
+        button.type =
+          "button";
+
+        button.dataset.panelServer =
+          "1";
+
+        button.textContent =
+          "Servers ▾";
+
+        button.title =
+          "Choose a server for this panel";
+
+        const replace =
+          actions.querySelector(
+            "[data-panel-replace]"
+          );
+
+        actions.insertBefore(
+          button,
+          replace || null
+        );
+      }
+
+      button.addEventListener(
+        "click",
+        (event) => {
+          event.stopPropagation();
+
+          openServers(
+            panel,
+            slot
+          );
+        }
+      );
+
+      ensureServerMenu(
+        panel
+      );
+
+      syncButton(
+        panel,
+        slot
+      );
+
+      const observer =
+        new MutationObserver(
+          () =>
+            syncButton(
+              panel,
+              slot
+            )
+        );
+
+      observer.observe(
+        panel,
+        {
+          attributes: true,
+          attributeFilter: [
+            "class"
+          ],
+          childList: true,
+          subtree: true
+        }
+      );
+    }
+  );
+
+  document.addEventListener(
+    "click",
+    (event) => {
+      if (
+        event.target.closest(
+          ".mv-server-menu"
+        ) ||
+        event.target.closest(
+          "[data-panel-server]"
+        )
+      ) {
+        return;
+      }
+
+      closeMenus();
+    }
+  );
+
+  document.addEventListener(
+    "keydown",
+    (event) => {
+      if (
+        event.key ===
+        "Escape"
+      ) {
+        closeMenus();
+      }
+    }
+  );
+})();
diff --git a/assets/eastcoins-multiview-servers.css b/assets/eastcoins-multiview-servers.css
new file mode 100644
