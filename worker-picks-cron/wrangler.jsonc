{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eastcoin-picks-cron",
  "main": "src/index.js",
  "compatibility_date": "2026-08-21",
  "workers_dev": true,

  // Every 10 minutes. Games end at unpredictable times, and settlement
  // is idempotent, so running often costs little: with nothing to grade
  // it is one D1 query and no outbound requests at all.
  // Two schedules: settlement every 5 minutes, and the database backup
  // once a day at 09:00 UTC (4 AM Central in summer, 3 AM in winter —
  // either way, hours after the last game and before anything opens).
  // Plus the daily recap at 8:50 AM Central: 13:50 UTC in summer, 14:50
  // in winter — both fire, the endpoint keeps the one that is 8 AM local.
  // And the weekly roundup on Mondays at 4:06 PM Central: 21:06 UTC in
  // summer, 22:06 in winter — same trick, the endpoint keeps the one
  // that is really Monday 4 PM local. NOT :05 — a minute the five-minute
  // settlement trigger also owns: on 2026-09-14 the 21:05 firing
  // delivered only the settlement event and the roundup never ran, so
  // the two schedules must never share a minute.
  "triggers": {
    "crons": ["*/5 * * * *", "0 9 * * *", "50 13,14 * * *", "6 21,22 * * 1"]
  },

  "vars": {
    "SETTLE_URL": "https://eastcoin.vip/api/picks/settle",
    "BACKUP_URL": "https://eastcoin.vip/api/admin/backup",
    "RECAP_URL": "https://eastcoin.vip/api/admin/recap",
    "WEEKLY_URL": "https://eastcoin.vip/api/admin/weekly"
  }

  // PICKS_CRON_KEY is a secret, set with:
  //   npx wrangler secret put PICKS_CRON_KEY
  // The same value must exist as a Pages environment variable so
  // /api/picks/settle recognises the caller.
}
